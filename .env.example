# Скопируйте в .env и поменяйте значения
DEBUG=false
DATABASE_URL=sqlite:///./luvvix.db
# PostgreSQL: DATABASE_URL=postgresql+psycopg://luvvix:password@localhost:5432/luvvix

# Обязательно смените! (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=CHANGE_ME_please_use_long_random_string_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Почта для 2FA. Пусто -> коды печатаются в консоль сервера.
# Пример для Яндекса: SMTP_HOST=smtp.yandex.ru, SMTP_PORT=465, SMTP_SSL=true, пароль приложения
# Пример для Gmail:   SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SSL=true, пароль приложения
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Первый администратор (создаётся при первом запуске)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@luvvix.local
ADMIN_PASSWORD=Admin12345!

MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=20
